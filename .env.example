# OPENROUTER_API_KEY: OpenRouter API key for free multimodal AI model inference.
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"

# OPENROUTER_MODEL: Free vision model identifier (default: "openrouter/free")
OPENROUTER_MODEL="openrouter/free"

# GEMINI_API_KEY: Direct Gemini API key (optional fallback)
GEMINI_API_KEY=""

# PORT: Local dev server port
PORT=3000
